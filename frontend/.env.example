# Config del frontend (Vite). Copiar a .env.local y ajustar según tu máquina.
# .env.local está gitignoreado; este .env.example sí se commitea.

# Origen del backend SIN el prefijo /api/v1.
# Máquina limpia: 8080. En la máquina de Santi el backend queda en :8088 (el 8080 lo ocupa GIA).
VITE_API_BASE_URL=http://localhost:8080

# Keycloak (realm bonosapp, client público bonosapp-frontend con Direct Access Grants).
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=bonosapp
VITE_KEYCLOAK_CLIENT_ID=bonosapp-frontend

# Casilla de contacto que se muestra en la landing y en el registro.
VITE_CONTACTO_EMAIL=info@bonosapp.com.ar

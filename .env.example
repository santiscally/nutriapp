# ============================================================
# BONOSAPP — plantilla de variables de entorno
# Copiar a .env y completar. NUNCA commitear el .env.
# ============================================================

# --- Postgres ---
POSTGRES_DB=bonosapp
POSTGRES_USER=bonosapp
POSTGRES_PASSWORD=bonosapp_dev_change_me
POSTGRES_PORT=5432

# --- Keycloak ---
# Bootstrap admin del CONTENEDOR Keycloak (su propio superusuario del realm master).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8081
# Service-account que usa el BACKEND para la Admin API (client_credentials del client confidencial
# bonosapp-backend, scopeado a realm-management manage-users/view-users — NO el superusuario master).
# Prod: regenerar el secret del client en el realm y setear este env con ese valor.
KEYCLOAK_ADMIN_CLIENT_ID=bonosapp-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=bonosapp-backend-dev-secret-change-me
# Prod: dominio público + issuer (ver docker-compose.prod.yml cuando exista)

# --- Backend ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# 5173 es el default de Vite; 5174 es el fallback cuando el 5173 lo ocupa otro proyecto.
# Si agregás un puerto acá, agregalo también a los redirectUris del client bonosapp-frontend
# en keycloak/realms/bonosapp-realm.json — si no, el login falla por CORS aunque el backend lo permita.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
TZ=America/Argentina/Buenos_Aires

# --- Frontend (build args) ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=bonosapp
VITE_KEYCLOAK_CLIENT_ID=bonosapp-frontend
# Modo pre-lanzamiento: `true` → `/` muestra la landing "Próximamente" y lo único público es
# `/registro` (el login queda en `/ingresar`, sin link). Se HORNEA en el build → cambiarlo exige
# `npm run build` de nuevo. Default (vacío/false) = app completa.
VITE_COMING_SOON=false
# Casilla de contacto que la landing y el registro muestran al visitante. Sigue en el dominio
# viejo hasta que el cliente mude el mail a @bonosapp.com.ar. También se hornea en el build.
VITE_CONTACTO_EMAIL=info@nutriappok.com.ar

# ============================================================
# Integraciones — mode: stub | live  (live recién en Fase 2)
# ============================================================

# --- Contabilium (ERP) ---
# client_id = email de la cuenta, client_secret = API key (así lo define su docu)
CONTABILIUM_MODE=stub
CONTABILIUM_CLIENT_ID=
CONTABILIUM_CLIENT_SECRET=
CONTABILIUM_BASE_URL=https://rest.contabilium.com

# --- Catálogo: qué entra al buscador de recetas (mail de Gon 2026-08-03) ---
# IdRubro que cuentan como "producto terminado". Vacío = sin filtro de rubro.
CATALOGO_RUBROS_PERMITIDOS=144331
# El Tipo de Contabilium tiene TRES valores en la cuenta de TBC: Producto (2004), Combo (209) y
# Servicio (54). El mail de Gon dice "solo Producto", pero apuntaba a sacar los servicios: los Combo
# son los packs x2/x3 y los exhibidores de la línea ON-ROLL propia, y se venden igual que el resto.
# Van los dos (a confirmar con él). Con solo "Producto" el catálogo recetable pasa de 702 a 496.
CATALOGO_TIPOS_ERP=Producto,Combo
# Precio irrisorio: tienen ~1000 artículos cargados a $1 que no son vendibles.
CATALOGO_PRECIO_MINIMO=100

# --- TiendaNube ---
# Requiere app en Partner Portal (OAuth2). store_id = user_id que devuelve el token endpoint.
# Scopes: read_products, read_orders, read_coupons, write_coupons. Van EN el token: cambiarlos exige reinstalar la app.
TIENDANUBE_MODE=stub
# En Fase 2, apuntar a la tienda demo antes que a la real (misma URL, distinto store_id/token).
TIENDANUBE_BASE_URL=https://api.tiendanube.com/2025-03
TIENDANUBE_STORE_ID=
# Vitrina pública de la tienda: va como link en el mail y en el WhatsApp del bono.
TIENDANUBE_STORE_URL=
TIENDANUBE_ACCESS_TOKEN=
TIENDANUBE_CLIENT_ID=
TIENDANUBE_CLIENT_SECRET=
# HMAC de los webhooks. En dev: valor conocido para firmar en los smoke. En live = client_secret de la app.
TIENDANUBE_WEBHOOK_SECRET=dev-webhook-secret
# Comillas obligatorias: los paréntesis rompen `. ./.env` desde bash (compose las stripea igual).
TIENDANUBE_USER_AGENT="BonosApp (contacto.simpleapps@gmail.com)"

# --- Email ---
# Resend: MAIL_MODE=live, host smtp.resend.com, puerto 587, usuario literal `resend`,
# password = API key (re_...), from = casilla del dominio verificado.
# Para probar en local sin proveedor: `docker compose --profile mail up -d` levanta Mailpit
# (webmail en http://localhost:8025) y se apunta MAIL_MODE=live, host `mailpit`, puerto 1025,
# MAIL_SMTP_AUTH=false y MAIL_SMTP_STARTTLS=false — no tiene ni auth ni TLS.
MAIL_MODE=stub
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
# Ambas true contra cualquier proveedor real; sólo se apagan contra el Mailpit local.
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM_ADDRESS=no-reply@bonosapp.local
MAIL_FROM_NAME=BonosApp
# Casilla que recibe el aviso de cada solicitud de registro. Vacía = nadie se entera y hay que
# mirar la tabla nutricionistas a mano para saber que alguien se registró.
ADMIN_NOTIFICATION_EMAIL=
# URL pública de la app: con esto se arman los links de los mails (login, bandeja del admin).
APP_PUBLIC_URL=http://localhost:5173

# ============================================================
# PRODUCCIÓN — sólo para docker-compose.prod.yml (ver DEPLOY.md)
# En dev estas no hacen falta. En prod son OBLIGATORIAS las marcadas (fail-closed).
# ============================================================
#
# ⚠️ NO hacer `cp .env.example .env` para prod y levantar tal cual: los valores de dev de
# arriba son DÉBILES/CONOCIDOS. Regenerar SÍ o SÍ estos tres antes de exponer el stack:
#   - POSTGRES_PASSWORD       (arriba = bonosapp_dev_change_me → poner uno fuerte)
#   - KEYCLOAK_ADMIN / KEYCLOAK_ADMIN_PASSWORD  (arriba = admin/admin → cambiar ambos)
#   - KEYCLOAK_ADMIN_CLIENT_SECRET (regenerar el secret del client en el realm de prod)
# El compose ABORTA (`:?`) si POSTGRES_PASSWORD / KEYCLOAK_ADMIN / KEYCLOAK_ADMIN_PASSWORD /
# KEYCLOAK_ADMIN_CLIENT_SECRET / KEYCLOAK_HOSTNAME no están seteados; pero NO detecta que sigan
# siendo los débiles de dev → es responsabilidad del operador cambiarlos.
#
# Dominio público CON /auth incluido. En KC 25 (hostname v2) el context path sale de esta URL,
# NO de KC_HTTP_RELATIVE_PATH: sin el /auth el .well-known publica URLs sin el prefijo y el
# login del SPA rompe. Verificado en el deploy del 2026-08-11.
KEYCLOAK_HOSTNAME=https://app.midominio.com/auth
# Perfil Spring de prod (lo fuerza el override, pero explícito para claridad).
SPRING_PROFILES_ACTIVE=prod
# JWK interno (nginx pone Keycloak bajo /auth). Normalmente no hace falta tocarlo.
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/auth/realms/bonosapp/protocol/openid-connect/certs
# Opcional: valida el claim `iss`. Vacío = sólo firma. Si se setea: <origen>/auth/realms/bonosapp
KEYCLOAK_ISSUER_URI=
# SPA same-origin → CORS normalmente vacío. Setear sólo si el front vive en otro origen.
APP_CORS_ALLOWED_ORIGINS=
# OBLIGATORIO en prod: regenerar el secret del client bonosapp-backend en el realm de prod.
# NUNCA reusar el placeholder de dev. El compose aborta si queda vacío.
# KEYCLOAK_ADMIN_CLIENT_SECRET=  (setear con el valor regenerado)
# Path de la SPA compilada que sirve nginx (default ./frontend/dist).
FRONTEND_DIST=./frontend/dist
# Backups cifrados (opcional pero recomendado): si se setea, scripts/backup-db.sh cifra el
# dump con GPG (los dumps traen PII de pacientes/recetas + el store de credenciales de Keycloak).
# Vacío = dumps en texto plano (advertido por el script). Restore autodetecta .gpg.
BACKUP_GPG_RECIPIENT=
#
# --- Frontend (build args) para PROD ---
# Se HORNEAN en `npm run build` (build-time, no runtime). Deben apuntar al origen público
# EXACTO que sirve nginx, o el `connect-src 'self'` de la CSP bloqueará los fetch de la SPA.
# Rebuild obligatorio si cambia el dominio. (En dev usan los http://localhost de arriba.)
#   VITE_API_BASE_URL=https://app.midominio.com
#   VITE_KEYCLOAK_URL=https://app.midominio.com/auth
#   VITE_COMING_SOON=true          # pre-lanzamiento: sólo landing + registro (ver DEPLOY.md)
#   VITE_CONTACTO_EMAIL=info@nutriappok.com.ar

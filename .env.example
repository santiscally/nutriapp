# ============================================================
# NUTRIAPP — plantilla de variables de entorno
# Copiar a .env y completar. NUNCA commitear el .env.
# ============================================================

# --- Postgres ---
POSTGRES_DB=nutriapp
POSTGRES_USER=nutriapp
POSTGRES_PASSWORD=nutriapp_dev_change_me
POSTGRES_PORT=5432

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8081
# Prod: dominio público + issuer (ver docker-compose.prod.yml cuando exista)

# --- Backend ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
TZ=America/Argentina/Buenos_Aires

# --- Frontend (build args) ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=nutriapp
VITE_KEYCLOAK_CLIENT_ID=nutriapp-frontend

# ============================================================
# Integraciones — mode: stub | live  (live recién en Fase 2)
# ============================================================

# --- Contabilium (ERP) ---
# client_id = email de la cuenta, client_secret = API key (así lo define su docu)
CONTABILIUM_MODE=stub
CONTABILIUM_CLIENT_ID=
CONTABILIUM_CLIENT_SECRET=
CONTABILIUM_BASE_URL=https://rest.contabilium.com

# --- TiendaNube ---
# Requiere app en Partner Portal (OAuth2). store_id = user_id que devuelve el token endpoint.
TIENDANUBE_MODE=stub
TIENDANUBE_STORE_ID=
TIENDANUBE_ACCESS_TOKEN=
TIENDANUBE_CLIENT_ID=
TIENDANUBE_CLIENT_SECRET=
TIENDANUBE_USER_AGENT=NutriApp (contacto.simpleapps@gmail.com)

# --- Email ---
MAIL_MODE=stub
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@nutriapp.local
MAIL_FROM_NAME=NutriApp

# --- WhatsApp ---
WHATSAPP_MODE=stub
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
